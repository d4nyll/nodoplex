meta {
  name: Create Edge
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/products/{{slug}}/edges
  body: json
  auth: none
}

headers {
  Nodoplex-User-Id: {{userId}}
}

body:json {
  {
    "kind": "dependency",
    "tailId": "{{nodeId}}",
    "headId": "{{parentId}}",
    "version": {{version}}
  }
}
