meta {
  name: List Nodes
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/products/{{slug}}/nodes
  body: none
  auth: none
}

headers {
  Nodoplex-User-Id: {{userId}}
}

params:query {
  ~type: task
  ~status: not_started
  ~archived: false
  ~blocked: false
  ~childrenOf: {{parentId}}
  ~sort: lastUpdated
  ~direction: descending
  ~startAfterKey: 0
  ~startAfterId: {{nodeId}}
  ~limit: 50
}
