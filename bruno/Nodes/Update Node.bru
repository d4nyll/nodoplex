meta {
  name: Update Node
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/products/{{slug}}/nodes/{{nodeId}}
  body: json
  auth: none
}

headers {
  Nodoplex-User-Id: {{userId}}
}

body:json {
  {
    "version": {{version}},
    "fields": { "status": "in_progress", "assignee": "{{userId}}" }
  }
}
